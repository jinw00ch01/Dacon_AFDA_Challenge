{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(**/.credentials.json)",
      "Read(**/syncthing/config.xml)",
      "Read(**/syncthing/key.pem)",
      "Edit(data/external/**)",
      "Edit(data/captures/**)",
      "Edit(data/derived/peer_reviews/**)",
      "Edit(data/derived/labels/human/**)",
      "Edit(data/derived/experiment_packets/inbox/**)",
      "Edit(Baseline/**)",
      "Edit(.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "for d in \"$CLAUDE_PROJECT_DIR\" \"$(git rev-parse --show-toplevel 2>/dev/null)\" C:/Dacon/Dacon_AFDA_Challenge_git C:/Dacon/Dacon_AFDA_Challenge; do [ -f \"$d/.claude/hooks/guard.py\" ] && exec python \"$d/.claude/hooks/guard.py\"; done; echo 'AFDA guard.py not found' >&2; exit 2",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
