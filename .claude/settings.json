{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Read(**/.credentials.json)",
      "Read(**/syncthing/config.xml)",
      "Read(**/syncthing/key.pem)",
      "Edit(data/external/**)",
      "Edit(data/captures/**)",
      "Edit(data/derived/peer_reviews/**)",
      "Edit(data/derived/labels/human/**)",
      "Edit(data/derived/experiment_packets/inbox/**)",
      "Edit(Baseline/**)",
      "Edit(.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
